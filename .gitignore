# ══════════ 密钥：绝不入库 ══════════
# backend/.env 里是真实 API Key。backend/.gitignore 已经拦了一道，
# 这里再拦一道：根目录的规则是最后一道闸，宁可重复也不能漏。
.env
*.env
!.env.example

# ══════════ Python ══════════
__pycache__/
*.py[cod]
.venv/
venv/

# ══════════ Node 与构建产物 ══════════
node_modules/
dist/

# ══════════ 系统与编辑器 ══════════
.DS_Store
Thumbs.db
.idea/
.vscode/

# ══════════ 本机工具状态 ══════════
# .claude/settings.json 是 Claude Code 在本机自动攒出来的权限记录，
# 里面写的是本机路径，对别人没有意义（曾经被 git add -A 误带进去过一次）。
# 忽略整个目录：将来若真要共享项目级配置（commands/、agents/），
# 用 git add -f 单独放行即可。
.claude/

# ══════════ 运行产物 ══════════
*.log
