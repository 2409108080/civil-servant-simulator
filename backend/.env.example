# 复制为 .env 后填入真实值：cp .env.example .env
# .env 必须加入 .gitignore，API Key 绝不出现在前端代码或任何提交中

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名可配置：若该 id 不可用，改这一行即可，无需动代码。
# 注意：不要照抄 DeepSeek 公开文档里的 deepseek-chat / deepseek-reasoner——
# 那是官方直连的 id，本项目用的中转 Key 不认这两个名字。
# 以该 Key 实际授权的列表为准，用下面的命令查：
#   curl -H "Authorization: Bearer $DEEPSEEK_API_KEY" $DEEPSEEK_BASE_URL/models
DEEPSEEK_MODEL=deepseek-flash

# 允许跨域的前端地址（Vue CLI 默认 8080）
ALLOW_ORIGINS=http://localhost:8080

# ── AI 调用参数（留空则用代码内默认值）──
# 单次请求超时（秒）。超时会自动降级为兜底事件，不会让玩家卡住。
# 必须比前端 api/event.js 的 REQUEST_TIMEOUT（90 秒）小，理由见那里。
DEEPSEEK_TIMEOUT=40
# 生成温度。官场剧本需要一点随机性，1.0 起步；想更稳妥可降到 0.7
DEEPSEEK_TEMPERATURE=1.0
# 生成**事件**时的输出上限。
# 注意本模型是推理模型，reasoning_content 与正文**共用**这个额度，
# 而思考比正文长得多：实测一次事件 思考 2320 字 + 正文 606 字，
# 思考占 79%。所以"事件正文才几百 token、1600 够用"是错的——
# 给 1600 时实测 6 次里 3 次写不完被截断，且降级是静默的（换预置事件、不报错），
# 玩家只会觉得"AI 老出重复题目"，想不到是预算不够。
DEEPSEEK_MAX_TOKENS=4000
# 考公命题与阅卷的**独立**输出上限，不要跟着上面那个走。
# 一套卷子是 10 道题 ×（题干 + 4 选项 + 解析），实测正文 4000 字上下。两个坑：
#   1. 中文实测 1.57 token/字（先前按 0.6～1 估，低估了两三倍）。
#   2. **本模型是推理模型，reasoning_content 与正文共用 max_tokens。**
#      实测一次命题：思考 7135 字 + 正文 4053 字 = 6361 token，
#      思考长度不受提示词控制、抖动极大。给 8000 时 3 次里炸 2 次
#      （思考短就写完、思考长就撞墙），看起来像"模型偶尔不守格式"，
#      实际是预算不够，改提示词是改不好的。
# max_tokens 是上限不是预扣，写不满不额外花钱，所以宁可给宽。
EXAM_GENERATE_MAX_TOKENS=20000
EXAM_GRADE_MAX_TOKENS=12000
# 超时也必须跟着产出量走，不能套用上面那个 25 秒。
# 25 秒是按事件定的（约 600 token、实测 8 秒）；卷子要写六倍多的字，
# 实测 37～48 秒，尾部抖动轻易顶穿 25 秒，表现为 APITimeoutError 而全线降级。
# 命题这个值必须比前端（frontend/src/api/exam.js 的 110 秒）小：
# 后端超时会降级成预置题库（还能玩），前端超时只会甩一张"命题失败"错误页。
# 两边原来都是 90，谁先到点不确定，等于把玩家的体验交给运气。
EXAM_GENERATE_TIMEOUT=75
EXAM_GRADE_TIMEOUT=60
# 是否启用 JSON 输出模式。若模型不支持该参数，置 false，仅靠提示词约束 + 服务端清洗
DEEPSEEK_JSON_MODE=true
# 格式跑偏时的重试次数（不含首次）
DEEPSEEK_MAX_RETRIES=1
