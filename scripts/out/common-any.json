      },
      {
        "id": "opt_b",
        "text": "只写自己那份，到点就走",
        "costAp": 1,
        "effects": {
          "energy": -6,
          "popularity": -10,
          "authority": 4,
          "ability": 3
        }
      },
      {
        "id": "opt_c",
        "text": "把提纲给他，让他照着填",
        "costAp": 0,
        "effects": {
          "energy": -4,
          "popularity": -6,
          "kpi": -4,
          "mgmt": -2
        }
      }
    ]
  },
  {
