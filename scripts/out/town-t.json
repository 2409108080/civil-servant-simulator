      {
        "id": "opt_b",
        "text": "再等等，盯紧水情",
        "costAp": 0,
        "effects": {
          "risk": 12,
          "kpi": -4,
          "popularity": -5,
          "authority": -4,
          "energy": 5
        }
      },
      {
        "id": "opt_c",
        "text": "让县里报市防指定",
        "costAp": 1,
        "effects": {
          "mgmt": 5,
          "authority": -8,
          "kpi": -4,
          "energy": -6
        }
      }
