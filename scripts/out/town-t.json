[
  {
    "id": "evt_town_t_flood_night_call",
    "title": "半夜险情电话",
    "npcName": "镇长 老赵",
    "unitType": "基层乡镇",
    "bands": [
      "厅级"
    ],
    "theme": "daily",
    "description": "夜里十一点，你联系的乡镇打来电话。上游水库泄洪，镇里那条河的水位离警戒线只差三十公分，河边两个村还有六百多人没转移。老赵在电话里说，转移一次要动用几十号人、安置点、车辆，万一水位回落到不了警戒线，镇上白折腾，群众也有怨气；可要是硬扛，出了事谁也担不起。他顿了顿，问你，是不是按预案先转移——意思很明白，这个决心得你替他下。",
    "options": [
      {
        "id": "opt_a",
        "text": "按预案，今晚就转",
        "costAp": 1,
        "effects": {
          "energy": -15,
